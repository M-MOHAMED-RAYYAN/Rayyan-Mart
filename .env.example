# RayyanMart environment variables
# Copy to `.env` (or set in your shell / service manager). Every value here maps
# to a `${VAR:default}` in application.properties.

# ---- HTTP ----
SERVER_PORT=8080

# ---- Database ----
# Default: external H2 TCP server (jdbc:h2:tcp://localhost:9092/rayyanmartdb).
# For MySQL:
#   DB_URL=jdbc:mysql://localhost:3306/rayyanmart?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
#   DB_DRIVER=com.mysql.cj.jdbc.Driver
# For embedded/in-memory H2 (local dev only):
#   DB_URL=jdbc:h2:mem:shopping_db;MODE=MySQL;DB_CLOSE_DELAY=-1;DATABASE_TO_LOWER=TRUE
DB_URL=jdbc:h2:tcp://localhost:9092/rayyanmartdb;MODE=MySQL;DATABASE_TO_LOWER=TRUE;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
DB_USERNAME=sa
DB_PASSWORD=sa
# Leave blank to let HikariCP auto-detect the driver from DB_URL.
DB_DRIVER=org.h2.Driver
# Hibernate schema mode: update (default) | create-drop | validate | none
DB_DDL_AUTO=update
# Run data.sql seeding after Hibernate creates tables: always | never
DB_INIT_MODE=always

# ---- Optional admin bootstrap ----
# If set, an ADMIN account is created on startup. For local demos only.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- AI shopping assistant ----
# Enable the chat widget/endpoint: true | false
CHAT_ENABLED=true
# Provider: mock (deterministic FAQ, no key) | gemini
CHAT_PROVIDER=mock
# Maximum message length accepted by POST /api/chat
CHAT_MAX_MESSAGE_LENGTH=500
# Rate limit: messages allowed per session per minute (HTTP 429 beyond this)
CHAT_RATE_LIMIT_PER_MINUTE=10
# Per-session answer cache size and TTL
CHAT_CACHE_SIZE=50
CHAT_CACHE_TTL_SECONDS=120

# ---- Google Gemini (optional; ONLY used when CHAT_PROVIDER=gemini) ----
# IMPORTANT: this is read server-side only and never sent to the browser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_MS=8000